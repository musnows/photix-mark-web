{
  "name": "yingqian",
  "version": "1.0.4",
  "type": "module",
  "private": true,
  "scripts": {
    "brand:build": "node scripts/build-brand-assets.mjs",
    "test:brand": "node --test tests/brand-compatibility.test.cjs",
    "mini:build": "node scripts/build-miniprogram.mjs",
    "mini:dev": "node scripts/start-miniprogram.mjs",
    "test:mini": "node scripts/build-miniprogram.mjs && node --test --test-concurrency=1 tests/miniprogram.test.mjs",
    "test:mini:runtime": "node scripts/start-miniprogram-tests.mjs",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "node scripts/start-desktop.mjs",
    "desktop:pack": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --config electron-builder.config.cjs",
    "test:desktop": "node --test tests/desktop.test.cjs tests/signature-storage.test.cjs",
    "test:metadata": "node --test tests/full-exif.test.ts tests/export-exif.test.ts tests/builtin-logos.test.ts",
    "test:signature": "node --test tests/signature.test.ts",
    "test:hidden-watermark": "node --test tests/hidden-watermark.test.ts tests/hidden-watermark-robust.test.ts",
    "test:templates": "node --test tests/template-defaults.test.ts"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@simonwep/pickr": "^1.9.1",
    "exifr": "^7.1.3",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "nuxt": "^4.2.2",
    "viewerjs": "^1.11.7",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@open-wxa/wxa-runner-core": "0.8.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/seo": "^3.3.0",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "radix-vue": "^1.9.17",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "wxa-runner": "^0.8.1"
  }
}
