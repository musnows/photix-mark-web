.editor { padding: 26rpx 28rpx 180rpx; }
.editor-heading .title { margin-top: 10rpx; font-size: 38rpx; }
.editor-heading .eyebrow { font-size: 16rpx; letter-spacing: 2rpx; }
.photo-strip { white-space: nowrap; width: 100%; margin: 26rpx 0; }
.photo-strip-inner { display: inline-flex; gap: 14rpx; padding: 4rpx; }
.photo-thumb { width: 84rpx; height: 84rpx; border-radius: 12rpx; overflow: hidden; border: 3rpx solid transparent; position: relative; }
.photo-thumb.selected { border-color: #c99a35; }
.photo-thumb image { width: 100%; height: 100%; }
.photo-number { position: absolute; bottom: 0; right: 0; font-size: 17rpx; color: white; padding: 0 6rpx; background: rgba(0,0,0,.42); border-radius: 5rpx 0 0 0; }
.page .add-photo { width: 84rpx; min-width: 84rpx; height: 84rpx; font-size: 38rpx; line-height: 78rpx; padding: 0; border: 2rpx dashed #d8d2c2; background: transparent; border-radius: 12rpx; }
.preview-stage { position: relative; min-height: 160rpx; border-radius: 16rpx; overflow: hidden; background: #eae7df; display: flex; justify-content: center; padding: 24rpx; }
.preview-image { width: 100%; max-width: 660rpx; height: auto; display: block; box-shadow: 0 8rpx 20rpx rgba(0,0,0,.07); }
.preview-placeholder { height: 350rpx; display: flex; align-items: center; color: #8c887b; font-size: 25rpx; }
.preview-status { position: absolute; right: 38rpx; top: 38rpx; border-radius: 24rpx; background: rgba(255,255,255,.9); padding: 8rpx 18rpx; font-size: 22rpx; }
.preview-caption { padding: 8rpx 4rpx; }
.editor-tabs { display: flex; background: #edebe4; padding: 7rpx; gap: 6rpx; border-radius: 18rpx; margin: 22rpx 0; }
.editor-tab { flex: 1; font-size: 26rpx; padding: 15rpx 8rpx; background: transparent; color: #8c887e; border-radius: 12rpx; }
.editor-tab.active { background: #fff; color: #342e20; font-weight: 600; box-shadow: 0 2rpx 7rpx rgba(0,0,0,.04); }
.settings-panel { border-radius: 22rpx; }
.section-label { font-size: 28rpx; font-weight: 650; }
.template-chips { margin-top: 22rpx; }
.apply-all { margin-top: 26rpx; font-size: 25rpx; }
.feedback { margin-top: 18rpx; }
.editor-footer { text-align: center; margin: 28rpx 0; }
.raw-exif { max-height: 540rpx; overflow: auto; }
.raw-row { display: flex; flex-direction: column; gap: 5rpx; padding: 14rpx 0; border-top: 1rpx solid #efede7; word-break: break-all; font-size: 24rpx; }
.signature-preview { margin-top: 20rpx; background: #e9e7de; border-radius: 16rpx; padding: 20rpx; }
.signature-preview image { display: block; width: 100%; height: 130rpx; }
.hidden-section { margin-top: 22rpx; }
.save-bar { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); background: rgba(250,249,246,.98); border-top: 1rpx solid #e9e5dc; }
.save-bar .row { max-width: 1000rpx; margin: 0 auto; }
.save-bar button { font-size: 26rpx; }
.save-single, .save-all { flex: 1; }
.save-current { flex: 1; }
.export-progress { min-height: 80rpx; font-size: 27rpx; color: #967127; }
.locked { pointer-events: none; opacity: .65; }
