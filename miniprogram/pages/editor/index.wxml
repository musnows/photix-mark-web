<view class="page editor">
  <view class="row editor-heading"><view><view class="eyebrow mono">YOUR PHOTO, YOUR SIGNATURE</view><view class="title">{{templateName}}</view></view><text class="badge">{{activeIndex + 1}} / {{photos.length}}</text></view>
  <scroll-view scroll-x class="photo-strip"><view class="photo-strip-inner"><view wx:for="{{photos}}" wx:key="id" class="photo-thumb {{index === activeIndex ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectPhoto"><image src="{{item.path}}" mode="aspectFill" /><text class="photo-number mono">{{index + 1}}</text></view><button wx:if="{{photos.length < 9}}" id="add-photos" class="add-photo" disabled="{{importing || exporting}}" bindtap="addPhotos">＋</button></view></scroll-view>
  <view class="preview-stage">
    <image wx:if="{{preview}}" id="photo-preview" class="preview-image" src="{{preview}}" mode="widthFix" bindtap="previewImage" />
    <view wx:else class="preview-placeholder"><text>正在准备照片…</text></view>
    <view wx:if="{{rendering}}" class="preview-status">正在更新预览</view>
  </view>
  <view class="row preview-caption"><text class="small muted">{{isDemo ? '示例照片' : '轻点查看大图'}} · <text class="mono">{{sourceSize}}</text></text><button class="link small" disabled="{{exporting}}" bindtap="removePhoto">移出</button></view>
  <view wx:if="{{error}}" id="editor-error" class="error feedback">{{error}}</view>
  <view wx:if="{{notice}}" id="editor-notice" class="notice feedback">{{notice}}</view>
  <button wx:if="{{needsPermission}}" class="secondary feedback" open-type="openSetting" bindopensetting="permissionChanged">打开设置，允许保存到相册</button>
  <view class="editor-tabs"><button wx:for="{{tabs}}" wx:key="id" id="tab-{{item.id}}" class="editor-tab {{tab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectTab">{{item.name}}</button></view>
  <view class="card card-body settings-panel {{exporting || importing ? 'locked' : ''}}">
    <block wx:if="{{tab === 'template'}}">
      <view class="section-label">选择版式</view>
      <view class="chips template-chips"><button wx:for="{{templates}}" wx:key="id" id="template-{{item.id}}" class="chip {{templateId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectTemplate">{{item.name}}</button></view>
      <view wx:if="{{options.logo}}" class="field"><view class="row"><text class="field-label">品牌 Logo</text><switch color="#d3a239" checked="{{config.logoEnabled}}" data-key="logoEnabled" bindchange="changeConfig" /></view><picker wx:if="{{config.logoEnabled}}" range="{{logos}}" range-key="name" value="{{logoIndex}}" bindchange="changeLogo"><view class="picker">{{logos[logoIndex].name}} <text class="muted">⌄</text></view></picker></view>
      <view wx:if="{{options.background}}" class="field"><text class="field-label">背景颜色</text><input class="mono" value="{{config.backgroundColor}}" maxlength="32" data-key="backgroundColor" bindblur="changeConfig" placeholder="#FFFFFF" /></view>
      <view wx:if="{{options.colors}}" class="field"><text class="field-label">文字颜色</text><input class="mono" value="{{config.textColor}}" maxlength="32" data-key="textColor" bindblur="changeConfig" placeholder="#242424" /></view>
      <view wx:if="{{options.layout}}" class="field"><view class="row"><text class="field-label">主图留白</text><text class="mono small">{{labels.imageMargin}}%</text></view><slider min="0" max="22" step="1" value="{{config.imageMargin * 100}}" activeColor="#d3a239" block-size="20" data-key="imageMargin" data-scale="100" bindchange="changeConfig" /></view>
      <view wx:if="{{options.typography}}" class="field"><view class="row"><text class="field-label">竖向照片字号</text><text class="mono small">{{labels.watermarkScale}}%</text></view><slider min="50" max="150" step="5" value="{{config.watermarkScale * 100}}" activeColor="#d3a239" block-size="20" data-key="watermarkScale" data-scale="100" bindchange="changeConfig" /></view>
      <view wx:if="{{options.border}}" class="field"><view class="row"><text class="field-label">圆角</text><text class="mono small">{{labels.borderRadius}}%</text></view><slider min="0" max="8" step="1" value="{{config.borderRadius * 100}}" activeColor="#d3a239" block-size="20" data-key="borderRadius" data-scale="100" bindchange="changeConfig" /></view>
      <view wx:if="{{options.shadow}}" class="field"><view class="row"><text class="field-label">照片阴影</text><switch color="#d3a239" checked="{{config.shadowEnabled}}" data-key="shadowEnabled" bindchange="changeConfig" /></view></view>
      <block wx:if="{{options.blur}}"><view class="field"><view class="row"><text class="field-label">背景模糊</text><text class="mono small">{{labels.blurRadius}}%</text></view><slider min="1" max="10" step="1" value="{{config.blurRadius * 100}}" activeColor="#d3a239" block-size="20" data-key="blurRadius" data-scale="100" bindchange="changeConfig" /></view><view class="field"><view class="row"><text class="field-label">暗角</text><switch color="#d3a239" checked="{{config.vignetteEnabled}}" data-key="vignetteEnabled" bindchange="changeConfig" /></view><slider wx:if="{{config.vignetteEnabled}}" min="0" max="100" value="{{config.vignetteStrength * 100}}" activeColor="#d3a239" block-size="20" data-key="vignetteStrength" data-scale="100" bindchange="changeConfig" /></view></block>
      <block wx:if="{{options.nikonZ}}"><view class="field"><text class="field-label">Z 标识颜色</text><input class="mono" value="{{config.nikonZColor}}" maxlength="32" data-key="nikonZColor" bindblur="changeConfig" /></view><view class="field"><view class="row"><text class="field-label">Z 标识大小</text><text class="mono small">{{labels.nikonZScale}}%</text></view><slider min="80" max="120" step="20" value="{{config.nikonZScale * 100}}" activeColor="#d3a239" block-size="20" data-key="nikonZScale" data-scale="100" bindchange="changeConfig" /></view></block>
      <block wx:if="{{options.personalText}}"><view class="field"><text class="field-label">个性文字</text><textarea value="{{config.personalText}}" maxlength="120" data-key="personalText" bindblur="changeConfig" placeholder="写下你的署名" /></view><view class="field"><picker range="{{textPositions}}" value="{{textPositionIndex}}" bindchange="changeTextPosition"><view class="picker">位置 · {{textPositions[textPositionIndex]}} ⌄</view></picker></view><view class="field"><text class="field-label">文字大小</text><slider min="10" max="80" step="2" value="{{config.textFontSize * 1000}}" activeColor="#d3a239" block-size="20" data-key="textFontSize" data-scale="1000" bindchange="changeConfig" /></view><view class="field"><text class="field-label">文字透明度</text><slider min="10" max="100" value="{{config.textOpacity * 100}}" activeColor="#d3a239" block-size="20" data-key="textOpacity" data-scale="100" bindchange="changeConfig" /></view></block>
      <button wx:if="{{photos.length > 1}}" id="apply-all" class="secondary apply-all" bindtap="applyToAll">将样式应用到全部 {{photos.length}} 张</button>
    </block>
    <block wx:elif="{{tab === 'exif'}}">
      <view class="row"><text class="section-label">照片参数</text><button class="link small" bindtap="resetExif">恢复读取值</button></view>
      <view class="hint">开关控制水印显示，编辑仅改变画面上的文字。</view>
      <view wx:if="{{metadataWarning}}" class="notice feedback">{{metadataWarning}}</view>
      <view wx:for="{{fields}}" wx:key="key" class="field"><view class="row"><text class="field-label">{{item.label}}</text><switch color="#d3a239" checked="{{item.visible}}" data-key="{{item.showKey}}" bindchange="changeConfig" /></view><input id="exif-{{item.key}}" value="{{item.value}}" placeholder="未读取到，可手动填写" maxlength="160" data-key="{{item.key}}" bindblur="changeExif" /></view>
      <view class="field"><text class="field-label">时间显示格式</text><picker range="{{dateFormats}}" range-key="label" value="{{dateIndex}}" bindchange="changeDate"><view class="picker">{{dateFormats[dateIndex].label}} ⌄</view></picker><input wx:if="{{config.dateTimeFormat === 'custom'}}" class="mono" value="{{config.customDateTimeFormat}}" maxlength="120" placeholder="YYYY-MM-DD HH:mm:ss" data-key="customDateTimeFormat" bindblur="changeConfig" /></view>
      <button class="link" bindtap="toggleRaw">{{showRaw ? '收起' : '查看'}}原始 EXIF · {{rawFields.length}} 项</button>
      <view wx:if="{{showRaw}}" class="raw-exif"><view wx:for="{{rawFields}}" wx:key="key" class="raw-row"><text class="mono small muted">{{item.key}}</text><text selectable>{{item.value}}</text></view><view wx:if="{{!rawFields.length}}" class="hint">这张照片未包含可读取的 EXIF。</view></view>
    </block>
    <block wx:elif="{{tab === 'signature'}}">
      <view class="section-label">PNG 手写签名</view><view class="hint">选择透明背景的 PNG，自动裁去透明留白。</view>
      <view wx:if="{{signature.dataUrl}}" class="signature-preview"><image src="{{signature.dataUrl}}" mode="aspectFit" /></view>
      <button id="choose-signature" class="secondary apply-all" loading="{{importing}}" bindtap="chooseSignature">{{signature.dataUrl ? '更换签名 PNG' : '导入签名 PNG'}}</button>
      <block wx:if="{{signature.dataUrl}}">
        <view class="field row"><text class="field-label">显示签名</text><switch color="#d3a239" checked="{{signature.enabled}}" data-key="enabled" bindchange="changeSignature" /></view>
        <view class="field"><picker range="{{signaturePositions}}" value="{{signature.position === 'custom' ? 1 : 0}}" data-key="position" bindchange="changeSignature"><view class="picker">{{signature.position === 'custom' ? '自定义位置' : '跟随模板'}} ⌄</view></picker></view>
        <view wx:if="{{signature.position === 'template'}}" class="field"><picker range="{{signatureAnchors}}" value="{{signatureAnchorIndex}}" data-key="anchor" bindchange="changeSignature"><view class="picker">{{signatureAnchors[signatureAnchorIndex]}} ⌄</view></picker></view>
        <view class="field"><view class="row"><text class="field-label">签名大小</text><text class="mono small">{{labels.signatureWidth}}%</text></view><slider min="1" max="70" value="{{signature.width * 100}}" activeColor="#d3a239" block-size="20" data-key="width" data-scale="100" bindchange="changeSignature" /></view>
        <block wx:if="{{signature.position === 'custom'}}"><view class="field"><text class="field-label">水平位置</text><slider min="0" max="100" value="{{signature.x * 100}}" activeColor="#d3a239" block-size="20" data-key="x" data-scale="100" bindchange="changeSignature" /></view><view class="field"><text class="field-label">垂直位置</text><slider min="0" max="100" value="{{signature.y * 100}}" activeColor="#d3a239" block-size="20" data-key="y" data-scale="100" bindchange="changeSignature" /></view></block>
        <view class="field"><picker range="{{signatureMasks}}" value="{{signatureMaskIndex}}" data-key="mask" bindchange="changeSignature"><view class="picker">{{signatureMasks[signatureMaskIndex]}} ⌄</view></picker><input wx:if="{{signature.mask === 'custom'}}" class="mono" value="{{signature.color}}" maxlength="32" data-key="color" bindblur="changeSignature" /></view>
        <view class="field"><text class="field-label">签名透明度</text><slider min="5" max="100" value="{{signature.opacity * 100}}" activeColor="#d3a239" block-size="20" data-key="opacity" data-scale="100" bindchange="changeSignature" /></view>
      </block>
      <view class="field hidden-section"><view class="row"><view><text class="section-label">隐藏水印</text><view class="hint">将你的标识写入照片像素</view></view><switch id="hidden-watermark-toggle" color="#d3a239" checked="{{config.hiddenWatermarkEnabled}}" data-key="hiddenWatermarkEnabled" bindchange="changeConfig" /></view><block wx:if="{{config.hiddenWatermarkEnabled}}"><input id="hidden-watermark-text" value="{{config.hiddenWatermarkText}}" maxlength="64" data-key="hiddenWatermarkText" bindinput="changeConfig" placeholder="你的名字或作品编号" /><view class="row hint"><text>使用无损 PNG 导出</text><text class="mono">{{markerLength}} / 64 bytes</text></view><view class="hint">标识会在保存时写入。压缩、缩放与截图可能影响检测结果。</view></block></view>
    </block>
    <block wx:elif="{{tab === 'export'}}">
      <view class="section-label">导出设置</view>
      <view class="field"><text class="field-label">照片长边上限</text><picker range="{{sizeLabels}}" value="{{sizeIndex}}" data-key="maxSide" bindchange="changeSetting"><view class="picker">{{sizeLabels[sizeIndex]}} ⌄</view></picker><view class="hint">不放大小图，总像素上限为 400 万，逐张处理以控制内存。</view></view>
      <view class="field"><text class="field-label">文件格式</text><picker disabled="{{config.hiddenWatermarkEnabled}}" range="{{formats}}" value="{{formatIndex}}" data-key="format" bindchange="changeSetting"><view class="picker">{{config.hiddenWatermarkEnabled ? 'PNG · 隐藏水印使用无损格式' : formats[formatIndex]}} ⌄</view></picker></view>
      <view class="field"><view class="row"><text class="field-label">保留原始 EXIF</text><switch color="#d3a239" checked="{{settings.preserveExif}}" data-key="preserveExif" bindchange="changeSetting" /></view><view class="hint">保留相机原始记录；手动编辑的水印文字不写回原始 EXIF。</view></view>
      <view wx:if="{{settings.preserveExif}}" class="field"><view class="row"><text class="field-label">仅保留摄影参数</text><switch color="#d3a239" checked="{{settings.photographyOnly}}" data-key="photographyOnly" bindchange="changeSetting" /></view><view class="hint">去除 GPS、设备序列号、作者、备注等额外信息。</view></view>
      <view class="notice feedback">{{isDemo ? '当前为示例照片，导出不会附加模拟的 EXIF。' : '只生成新照片，原始照片保持不变。'}} 微信或相册可能进一步处理文件，分享时建议发送原图。</view>
      <button wx:if="{{lastExport}}" id="detect-export" class="secondary apply-all" bindtap="detectExport">检测刚才导出的照片</button>
    </block>
  </view>
  <view class="editor-footer hint">所有处理均在本地完成</view>
  <view class="save-bar"><view wx:if="{{exporting}}" class="export-progress row"><text>{{progress}}</text><button class="link" bindtap="cancelExport">停止</button></view><view wx:else class="row"><button id="save-current" class="{{photos.length > 1 ? 'secondary save-current' : 'primary save-single'}}" disabled="{{importing || rendering || !preview}}" bindtap="savePhotos">保存当前照片</button><button wx:if="{{photos.length > 1}}" id="save-all" class="primary save-all" data-all="true" disabled="{{importing || rendering || !preview}}" bindtap="savePhotos">全部保存 · {{photos.length}}</button></view></view>
  <canvas type="2d" id="exportCanvas" class="canvas-export"></canvas>
</view>
