.brand-row { margin-bottom: 54rpx; }
.hero .headline { margin: 18rpx 0 22rpx; }
.hero .subtitle { line-height: 1.85; }
.sample-card { margin-top: 40rpx; border-radius: 8rpx; box-shadow: 0 12rpx 32rpx rgba(58, 50, 31, .07); }
.sample-image { display: block; width: 100%; height: 422rpx; }
.sample-caption { padding: 20rpx 26rpx; }
.camera-name { font-size: 23rpx; font-weight: 700; }
.sample-params { color: #87877c; font-size: 17rpx; margin-top: 4rpx; }
.sample-logo { width: 62rpx; height: 62rpx; }
.sample-note { display: flex; align-items: center; gap: 24rpx; color: #99968c; font-size: 21rpx; margin: 18rpx 0 34rpx; }
.sample-note .mono { color: #b68a32; font-size: 19rpx; }
.actions .primary { width: 100%; padding: 26rpx; font-size: 29rpx; border-radius: 18rpx; }
.secondary-actions { padding: 0 4rpx; }
.privacy { justify-content: flex-start; margin-top: 32rpx; padding: 26rpx; background: #f2f0e9; border-radius: 20rpx; }
.privacy-symbol { width: 52rpx; height: 52rpx; background: #fff; color: #9a8d63; border-radius: 50%; text-align: center; line-height: 52rpx; }
.template-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx 20rpx; }
.template-card { min-width: 0; }
.template-mini { height: 220rpx; background: #eae7de; padding: 18rpx; border-radius: 18rpx; overflow: hidden; }
.template-mini image { display: block; width: 100%; height: 150rpx; }
.mini-caption { height: 34rpx; background: #fff; padding: 10rpx 12rpx; display: flex; gap: 30rpx; }
.mini-caption view { height: 4rpx; width: 70rpx; background: #8a8a80; }
.mini-caption view:last-child { width: 45rpx; background: #c8c3b5; }
.template-label { margin: 10rpx 6rpx 0; font-size: 25rpx; }
.template-label .mono { font-size: 19rpx; }
.template-noProcess .mini-caption, .template-personalText .mini-caption, .template-folderNameParams .mini-caption { background: transparent; }
.template-blurBackground, .template-nikonBlur { background: #687160; padding: 24rpx 26rpx; }
.template-blurBackground image, .template-nikonBlur image { height: 136rpx; border-radius: 5rpx; }
.template-blurBackground .mini-caption, .template-nikonBlur .mini-caption { background: transparent; justify-content: center; }
.template-blurBackground .mini-caption view, .template-nikonBlur .mini-caption view { background: #e5e7da; }
.template-centeredWatermark { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
.template-sidebarWatermark { display: flex; }
.template-sidebarWatermark image { width: 80%; height: 184rpx; }
.template-sidebarWatermark .mini-caption { height: 184rpx; width: 20%; flex-direction: column; gap: 18rpx; }
.template-sidebarWatermark .mini-caption view { width: 5rpx; height: 42rpx; }
