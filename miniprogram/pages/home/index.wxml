<view class="page home">
  <view class="row brand-row"><view class="brand"><image class="brand-mark" src="/assets/yingqian-logo.png" mode="aspectFit" aria-label="映签 Logo" />映签</view><button id="open-detect" class="link" bindtap="detect">水印检测 ↗</button></view>
  <view class="hero">
    <text class="eyebrow mono">MADE FOR YOUR PHOTOGRAPHS</text>
    <view class="headline">让每一张照片<view class="accent">都有你的署名。</view></view>
    <view class="subtitle">相机参数、品牌印记与专属签名，<view>为你记录的瞬间，添上最后一笔。</view></view>
  </view>
  <view class="sample-card card">
    <image class="sample-image" src="/assets/sample.jpg" mode="aspectFill" />
    <view class="sample-caption row"><view><view class="camera-name mono">NIKON Z 6_2</view><view class="sample-params mono">67mm · f/6.3 · 1/200s · ISO 360</view></view><image class="sample-logo" src="/logos/nikon.png" mode="aspectFit" /></view>
  </view>
  <view class="sample-note"><text class="mono">01 / 11</text><text>经典版式 · 实拍示例</text></view>
  <view class="actions stack">
    <button id="choose-photos" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="choosePhotos">＋ 选择照片，开始制作</button>
    <view class="row secondary-actions"><button id="use-demo" class="link" disabled="{{busy}}" bindtap="useDemo">先用示例体验</button><button wx:if="{{photoCount}}" id="resume" class="link" bindtap="resume">继续编辑 {{photoCount}} 张照片 →</button><text wx:else class="hint">一次最多选择 9 张</text></view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view class="privacy row"><view class="privacy-symbol">✓</view><view><view class="field-label">照片只在你的设备上处理</view><view class="hint">无需登录，无需上传，保留原始照片。</view></view></view>
  <view class="section">
    <view class="row section-head"><view class="title">选一款，适合你的风格</view><text class="badge">11 款模板</text></view>
    <view class="template-grid"><view wx:for="{{templates}}" wx:key="id" class="template-card" data-id="{{item.id}}" bindtap="useDemo"><view class="template-mini template-{{item.id}}"><image src="/assets/sample.jpg" mode="aspectFill" /><view class="mini-caption"><view></view><view></view></view></view><view class="row template-label"><text>{{item.name}}</text><text class="mono muted">{{item.number}}</text></view></view></view>
  </view>
  <view class="footer mono">映签 · 每一张，都是你的作品</view>
</view>
